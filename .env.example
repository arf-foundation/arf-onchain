# ARF Onchain — environment template
#
# Copy to .env and fill in. `.env` is gitignored; this file is not, so it must
# never contain a real key.
#
#   cp .env.example .env
#
# Foundry scripts read these with vm.envUint / vm.envString, so a missing or
# malformed value fails the script immediately rather than deploying something
# half-configured.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Monad Testnet. The public endpoint below works for reads and deploys; use your
# own provider if you are rate-limited.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# ---------------------------------------------------------------------------
# Keys — never commit these, and do not paste them into a chat or an issue
# ---------------------------------------------------------------------------

# Deploys the contracts and becomes owner of AgentRegistry, PolicyRegistry,
# RiskAttestationRegistry, ExecutionGuard, TreasuryVault and AuditRegistry.
# Needs testnet MON for gas. Hex, with or without the 0x prefix.
DEPLOYER_PRIVATE_KEY=

# Signs governance attestations. ExecutionGuard accepts signatures from exactly
# one address — whatever `trustedEvaluator` is set to — so this key is the trust
# anchor of the whole protocol.
#
# Deploy.s.sol passes the DEPLOYER as the initial trusted evaluator. If you want
# them separate, call setTrustedEvaluator with this key's address after
# deploying, and record the value in docs/deployments.md.
ARF_EVALUATOR_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Agent registration — read by script/RegisterAgent.s.sol
# ---------------------------------------------------------------------------

# The deployed AgentRegistry. Required; the script has no default, because a
# stale hardcoded address is how two register scripts once ended up configuring
# two different deployments.
AGENT_REGISTRY_ADDRESS=

# The agent's wallet and owner. Both default to the deployer address.
AGENT_WALLET=
AGENT_OWNER=

# Per-transaction cap, enforced by ExecutionGuard. In wei.
AGENT_MAX_TX_WEI=

# Daily cap. Stored on the agent; see docs for what the guard currently
# enforces before relying on it.
AGENT_DAILY_LIMIT_WEI=

# ---------------------------------------------------------------------------
# After deploying
# ---------------------------------------------------------------------------
#
#   1. Deploy.s.sol calls setExecutionGuard itself. Without that binding the
#      registry rejects every consume and nothing can execute.
#   2. Call setTrustedEvaluator if the evaluator is not the deployer.
#   3. Register agents with script/RegisterAgent.s.sol. registerAgent derives
#      the id from the wallet address, so the unreachable registration that
#      used to be possible — any id other than the one execute() computes — no
#      longer is. Set AGENT_REGISTRY_ADDRESS below.
#   4. Sign attestations as EIP-712 typed data, not eth_sign over intentHash.
#      ExecutionGuard.hashAttestation() returns the exact digest — check your
#      signer against it rather than reimplementing AttestationLib's encoding.
#   5. Update docs/deployments.md with the new addresses.
